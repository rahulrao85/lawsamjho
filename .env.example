# Server-only. Copy to .env.local and fill in.
# Never commit .env.local -- .gitignore already excludes it.

# Required. Paid-tier Gemini key (free tier lets Google train on your prompts).
GEMINI_API_KEY=

# Primary model, then a single fallback tier. Pinned IDs, not `-latest` aliases.
# Model availability is per-key, not a fixed list: gemini-2.5-flash works on some
# keys and returns 404 "no longer available to new users" on others. Re-verify
# against generativelanguage.googleapis.com before changing these (see README).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Upload guard, in bytes.
MAX_UPLOAD_BYTES=2000000

# In-memory rate limit: N requests per window, per client.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
